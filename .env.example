# Slack Bot Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack App Token for Socket Mode (starts with xapp-)
SLACK_APP_TOKEN=xapp-your-app-token

# Claude Code OAuth Token (from `claude setup-token`)
# Use this if you have a Claude Max subscription
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-your-token

# OR Anthropic API Key (if using direct API access)
# ANTHROPIC_API_KEY=sk-ant-your-api-key

# Port for internal orchestrator communication (default: 3000)
ORCHESTRATOR_PORT=3000

# Working directory for Claude Code (default: current directory)
# WORKING_DIRECTORY=/path/to/your/project
